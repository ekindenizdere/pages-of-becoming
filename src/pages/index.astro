---
// Home: prototype "C · Contents" (prototypes/home-c.html), ported unchanged.
// Its scripts and styles live in public/home/; the pieces come from src/content/pieces/.
// The only difference from the prototype: the display font is Instrument Serif (see public/home/glyphs.js).
import '../styles/tokens.css';
import { pieces, pieceUrl, minutes, url } from '../lib';

const all = await pieces();
const published = all.filter((p) => p.data.status === 'published');
const upcoming = all.filter((p) => p.data.status === 'upcoming');

/** First sentence of a piece, as plain text: the "first line as a footnote" in the contents. */
const firstLine = (text = '') => {
  const plain = text
    .replace(/\[\^[^\]]+\]/g, '')
    .replace(/[*_`>#]/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/\s+/g, ' ')
    .trim();
  return plain.match(/^.+?[.?!…](?=\s|$)/)?.[0] ?? plain.slice(0, 120);
};
const toItem = (p: (typeof all)[number]) =>
  p.data.status === 'published'
    ? { title: p.data.title, min: minutes(p), first: firstLine(p.body), href: pieceUrl(p) }
    : { title: p.data.title, upcoming: true, first: p.data.teaser ? firstLine(p.data.teaser) : undefined };
const data = {
  opinion: all.filter((p) => p.data.kind === 'opinion').map(toItem),
  articles: all.filter((p) => p.data.kind === 'article').map(toItem),
};

const description = 'Essays on philosophy, cognitive science and science by Ekin Deniz Dere.';
const h = (path: string) => url(`home/${path}`);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Pages of Becoming</title>
  <meta name="description" content={description} />
  <meta property="og:title" content="Pages of Becoming" />
  <meta property="og:description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="stylesheet" href={url('styles/fonts.css')} />
  <link rel="stylesheet" href={h('lab.css')} />
  <link rel="stylesheet" href={h('home.css')} />
  <link rel="stylesheet" href={h('home-c.css')} />
</head>
<body class="home">
<header class="site-top">
  <a class="mark" href={url()}>Pages <em>of</em> Becoming</a>
  <nav><a href="#opinion">Opinion Pieces</a><a href="#articles">Articles</a></nav>
</header>

<main class="lab-main">
  <section class="lab-section hero" data-name="Pages of Becoming" data-once="on">
    <h1 class="visually-hidden">Pages of Becoming: the usual confusion but framed professionally</h1>
    <div class="hero-bg"></div>
    <div class="hero-title" aria-hidden="true"><span class="line l1">Pages<span class="of">of</span></span><span class="line l2"><span class="hero-becoming"></span></span></div>
    <p class="hero-sub">The usual confusion but framed professionally</p>
    <span class="hero-corner tl">Writing as a form of thinking.</span>
    <span class="hero-corner tr">{published.length} pages · {upcoming.length} becoming</span>
    <span class="hero-corner br">( open )</span>
  </section>

  <section class="lab-section wrap" data-name="Contents" id="contents">
    <div class="spread">
      <div class="page page-left">
        <div class="inner" data-sticky>
          <div class="small-bio" id="ekin">
            <img class="portrait" src={url('images/ekin-portrait.jpg')} alt="Portrait of Ekin Deniz Dere">
            <div>
              <p class="bio">I’m Ekin Deniz Dere, a cognitive scientist and science communicator mainly interested in how people and artificial systems make sense of the worlds they create through various forms of interactivity.</p>
              <div class="bio-links">
              <nav class="social" aria-label="Ekin elsewhere">
              <a href="https://www.linkedin.com/in/ekin-deniz-dere-70929b154" target="_blank" rel="noopener noreferrer" aria-label="Ekin Deniz Dere on LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
              <a href="https://www.forbes.at/autor/ekin-deniz-dere" target="_blank" rel="noopener noreferrer" aria-label="Ekin Deniz Dere’s articles on Forbes Austria">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="0" y="0" width="24" height="24" rx="2.2"/><text x="12" y="19.6" text-anchor="middle" font-family="PP Pangaia, Instrument Serif, serif" font-weight="700" font-size="19.5" fill="var(--paper)">F</text></svg>
              </a>
              </nav>
              </div>
            </div>
          </div>
          <span class="label q-label">( i ) The question</span>
          <p class="ink" data-ink>My background moves through economics, philosophy, and journalism, but keeps circling back to the question: <mark class="hl">what does it mean to be who we are?</mark></p>
          <div class="planes-stage" data-planes="quiet"></div>
          <span class="folio">— 1 —</span>
        </div>
      </div>
      <div class="page page-right">
        <span class="label">( ii ) Contents</span>
        <div class="part" id="opinion">
          <div class="title-stage" data-cap="shared" data-config="Opinion Pieces" role="img" aria-label="Opinion Pieces"></div>
          <div class="toc" data-list="opinion" data-style="contents"></div>
        </div>
        <div class="part" id="articles">
          <div class="title-stage" data-cap="shared" data-question="Articles" role="img" aria-label="Articles"></div>
          <div class="toc" data-list="articles" data-style="contents"></div>
        </div>
        <span class="folio">— 2 —</span>
      </div>
    </div>
  </section>
</main>

<footer class="lab-bottom">
  <div class="counter"><span class="ticks"></span><span data-counter-name>Pages of Becoming</span><span data-counter>01 / 02</span></div>
  <button class="lab-toggle" type="button" data-motion-toggle aria-pressed="true">Motion on</button>
</footer>

<script is:inline define:vars={{ data }}>window.POB_PIECES = data;</script>
<script is:inline src={h('vendor/opentype.min.js')}></script>
<script is:inline src={h('vendor/gsap.min.js')}></script>
<script is:inline src={h('vendor/ScrollTrigger.min.js')}></script>
<script is:inline src={h('vendor/SplitText.min.js')}></script>
<script is:inline src={h('vendor/lenis.min.js')}></script>
<script is:inline src={h('lab.js')}></script>
<script is:inline src={h('glyphs.js')}></script>
<script is:inline src={h('motif.js')}></script>
<script is:inline src={h('home.js')}></script>
<script is:inline src={h('home-boot.js')}></script>
</body>
</html>
