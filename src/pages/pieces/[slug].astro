---
import { render } from 'astro:content';
import PieceView from '../../components/PieceView.astro';
import { pieces, pieceUrl, url, languageLinks, type Piece } from '../../lib';

export async function getStaticPaths() {
  const all = await pieces();
  return all
    .filter((p) => p.data.status === 'published')
    .map((p, _i, list) => {
      const same = list.filter((q) => q.data.kind === p.data.kind);
      const i = same.indexOf(p);
      return { params: { slug: p.id }, props: { piece: p, prev: same[i - 1], next: same[i + 1] } };
    });
}
interface Props { piece: Piece; prev?: Piece; next?: Piece }
const { piece, prev, next } = Astro.props;
const { Content } = await render(piece);
const langs = await languageLinks(piece.id);
const section = piece.data.kind === 'opinion' ? { href: url('opinion/'), label: 'Opinion Pieces' } : { href: url('articles/'), label: 'Articles' };
const n = (p?: Piece) => (p ? { title: p.data.title, href: pieceUrl(p) } : undefined);
---
<PieceView lang="en" slug={piece.id} kind={piece.data.kind} title={piece.data.title} dedication={piece.data.dedication}
  langs={langs} prev={n(prev)} next={n(next)} section={section}>
  <Content />
</PieceView>
