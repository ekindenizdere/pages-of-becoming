---
// Translated piece pages (DE/TR), reached through the language switch on each piece.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PieceView from '../../../components/PieceView.astro';
import { url, languageLinks } from '../../../lib';
import { homeText } from '../../../home-text';

type T = CollectionEntry<'translations'>;
export async function getStaticPaths() {
  const all = await getCollection('translations', (t) => t.data.status === 'published');
  return all.map((t) => {
    const same = all.filter((q) => q.data.lang === t.data.lang && q.data.kind === t.data.kind).sort((a, b) => a.data.order - b.data.order);
    const i = same.indexOf(t);
    return { params: { lang: t.data.lang, slug: t.data.source }, props: { piece: t, prev: same[i - 1], next: same[i + 1] } };
  });
}
interface Props { piece: T; prev?: T; next?: T }
const { piece, prev, next } = Astro.props;
const { Content } = await render(piece);
const lang = piece.data.lang;
const langs = await languageLinks(piece.data.source);
const home = url(`${lang}/`);
const section = piece.data.kind === 'opinion' ? { href: `${home}#opinion`, label: homeText[lang].opinion } : { href: `${home}#articles`, label: homeText[lang].articles };
const n = (p?: T) => (p ? { title: p.data.title, href: url(`${lang}/pieces/${p.data.source}/`) } : undefined);
---
<PieceView lang={lang} slug={piece.data.source} kind={piece.data.kind} title={piece.data.title} dedication={piece.data.dedication}
  langs={langs} prev={n(prev)} next={n(next)} section={section}>
  <Content />
</PieceView>
