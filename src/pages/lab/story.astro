---
// Preview for review (not linked from the site): the story layout with its places and the journey map.
// Places are underlined where they first appear (the hairline of Eli's links). The margin that holds notes in the
// essays holds the journey instead: a line map of the coast with the route, dates, and a small car that follows
// your reading. It dances a little (the GPS of the chapter's "dancing car"), more when you hover it.
// The map frames the leg you are reading about; once the chapter reaches its last stop it zooms out to the road ahead.
// On phones the journey sits under the title. A tap or click on a place opens a small card.
import { getEntry, render } from 'astro:content';
import PieceView from '../../components/PieceView.astro';
import { url } from '../../lib';
import geo from '../../data/route-spanish-adventure.json';

const piece = (await getEntry('pieces', 'spanish-adventure-1'))!;
const { Content } = await render(piece);
// in the order of the journey. `anchor`: which mention moves the car there (0 = the first).
// `ahead`: named in the chapter, not reached yet. Dates and times as the chapter gives them.
const places = [
  { key: 'bcn', name: 'Barcelona airport', match: ['Barcelona airport'], where: 'El Prat de Llobregat, Barcelona', date: '11 Oct, 2 am', anchor: 0 },
  { key: 'cas', name: 'Castelldefels', match: ['Castelldefels'], where: 'Baix Llobregat, Barcelona', date: '11 Oct, morning', anchor: 0 },
  { key: 'gin', name: 'Port Ginesta', match: ['Port Ginesta'], where: 'Marina at Les Botigues de Sitges', date: '11 Oct', anchor: 0 },
  { key: 'gar', name: 'Garraf', match: ['Garraf'], where: 'Village of Sitges, below the Garraf Massif', date: '11 Oct', anchor: 0 },
  { key: 'cal', name: 'Calafell', match: ['Calafell'], where: 'Baix Penedès, Tarragona', date: '11 and 12 Oct', anchor: 2 },
  { key: 'alt', name: 'Altura', match: ['Altura'], where: 'Alto Palancia, Castellón', date: '12 Oct', ahead: true },
];
const langs = [{ lang: 'en', href: url('lab/story/') }];
const cfg = { places, geo, t: { journey: 'The journey', ahead: 'ahead', stop: 'Stop', approx: 'Roads approximate', end: 'Ahead: the end of the journey' } };
---
<PieceView lang="en" slug={piece.id} kind="story" title={piece.data.title} series={piece.data.series} chapter={piece.data.chapter}
  langs={langs} section={{ href: url('stories/'), label: 'Stories' }}>
  <Content />
  <script is:inline type="application/json" id="lab-places" set:html={JSON.stringify(cfg)} />
  <script is:inline>
    // runs once the whole page is there (the margin comes after the text)
    document.addEventListener('DOMContentLoaded', function () {
      var cfg = JSON.parse(document.getElementById('lab-places').textContent), G = cfg.geo, T = cfg.t;
      var prose = document.querySelector('.prose'), reader = document.querySelector('.reader'), head = document.querySelector('.title-block');
      var places = cfg.places, travelled = places.filter(function (p) { return !p.ahead; });
      var NS = 'http://www.w3.org/2000/svg';
      var mk = function (tag, attrs, parent) { var e = document.createElementNS(NS, tag); for (var k in attrs) e.setAttribute(k, attrs[k]); if (parent) parent.appendChild(e); return e; };
      var still = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. mark every mention of a place; the first one of each is underlined
      var esc = function (s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); };
      var rx = new RegExp('\\b(' + places.flatMap(function (p) { return p.match; }).sort(function (a, b) { return b.length - a.length; }).map(esc).join('|') + ')\\b', 'g');
      var keyOf = function (s) { return places.find(function (p) { return p.match.indexOf(s) !== -1; }).key; };
      var seen = {};
      var walk = document.createTreeWalker(prose, NodeFilter.SHOW_TEXT, { acceptNode: function (n) { return /^(SCRIPT|STYLE)$/.test(n.parentNode.nodeName) ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT; } }), nodes = [];
      while (walk.nextNode()) nodes.push(walk.currentNode);
      nodes.forEach(function (n) {
        var t = n.nodeValue; rx.lastIndex = 0; if (!rx.test(t)) return; rx.lastIndex = 0;
        var frag = document.createDocumentFragment(), last = 0, m;
        while ((m = rx.exec(t))) {
          frag.appendChild(document.createTextNode(t.slice(last, m.index)));
          var k = keyOf(m[0]), s = document.createElement('span');
          s.className = 'place' + (seen[k] ? '' : ' first'); s.dataset.place = k; s.textContent = m[0];
          if (!seen[k]) { s.tabIndex = 0; s.setAttribute('role', 'button'); s.setAttribute('aria-haspopup', 'dialog'); }
          seen[k] = true; frag.appendChild(s); last = m.index + m[0].length;
        }
        frag.appendChild(document.createTextNode(t.slice(last)));
        n.parentNode.replaceChild(frag, n);
      });

      // 2. the road: legs between consecutive stops, measured so the car can sit anywhere along them
      var keys = places.map(function (p) { return p.key; });
      var legs = keys.slice(0, -1).map(function (k, i) {
        var pts = G.legs[k + '-' + keys[i + 1]], acc = [0];
        for (var j = 1; j < pts.length; j++) acc.push(acc[j - 1] + Math.hypot(pts[j][0] - pts[j - 1][0], pts[j][1] - pts[j - 1][1]));
        return { pts: pts, acc: acc, len: acc[acc.length - 1], ahead: !!places[i + 1].ahead };
      });
      var along = function (leg, f) {
        var d = f * leg.len, j = 1;
        while (j < leg.pts.length - 1 && leg.acc[j] < d) j++;
        var a = leg.pts[j - 1], b = leg.pts[j], seg = leg.acc[j] - leg.acc[j - 1] || 1, u = Math.max(0, Math.min(1, (d - leg.acc[j - 1]) / seg));
        return { x: a[0] + (b[0] - a[0]) * u, y: a[1] + (b[1] - a[1]) * u, ang: Math.atan2(b[1] - a[1], b[0] - a[0]), j: j };
      };

      // 3. one journey view (map, caption, stops with dates); wide screens get it in the margin, phones under the title
      var journeys = [];
      var makeJourney = function (host, withList) {
        var box = document.createElement('section'); box.className = 'journey'; box.setAttribute('aria-label', T.journey);
        box.innerHTML = '<p class="j-h">' + T.journey + '</p>';
        var svg = mk('svg', { class: 'j-map', viewBox: '0 0 ' + G.w + ' ' + G.h, role: 'img', 'aria-label': places.map(function (p) { return p.name; }).join(', ') }, box);
        mk('path', { d: G.land, class: 'j-coast', 'vector-effect': 'non-scaling-stroke' }, svg);
        legs.forEach(function (l) { mk('polyline', { points: l.pts.join(' '), class: 'j-road' + (l.ahead ? ' ahead' : ''), 'vector-effect': 'non-scaling-stroke' }, svg); });
        var done = mk('polyline', { points: '', class: 'j-done', 'vector-effect': 'non-scaling-stroke' }, svg);
        var dots = places.map(function (p) {
          var g = mk('g', { class: 'j-stop' + (p.ahead ? ' ahead' : ''), 'data-place': p.key }, svg), xy = G.stops[p.key];
          mk('circle', { cx: xy[0], cy: xy[1], r: 3 }, g);
          var tx = mk('text', { x: xy[0], y: xy[1] }, g); tx.textContent = p.name;
          return { g: g, xy: xy };
        });
        // the car: a small side view in ink, its own drawing
        var car = mk('g', { class: 'j-car' }, svg), body = mk('g', {}, car);
        mk('path', { d: 'M-11 1 L-11 -3 Q-10 -5 -7 -5 L-4 -9 Q-3 -10 -1 -10 L4 -10 Q6 -10 7 -8 L9 -5 Q11 -5 11 -3 L11 1 Z', class: 'j-body' }, body);
        mk('path', { d: 'M-3 -8.6 L-1 -8.6 L-1 -5.4 L-5 -5.4 Z M1 -8.6 L4 -8.6 Q5 -8.6 5.6 -7.6 L7 -5.4 L1 -5.4 Z', class: 'j-win' }, body);
        mk('circle', { cx: -6, cy: 1.5, r: 2.6, class: 'j-wheel' }, body);
        mk('circle', { cx: 6, cy: 1.5, r: 2.6, class: 'j-wheel' }, body);
        var cap = document.createElement('p'); cap.className = 'j-cap'; box.appendChild(cap);
        var list = null;
        if (withList) {
          list = document.createElement('ol'); list.className = 'j-list';
          list.innerHTML = places.map(function (p) { return '<li data-place="' + p.key + '"' + (p.ahead ? ' class="ahead"' : '') + '><span class="n">' + p.name + '</span><span class="d">' + p.date + (p.ahead ? ', ' + T.ahead : '') + '</span></li>'; }).join('');
          box.appendChild(list);
        }
        var note = document.createElement('p'); note.className = 'j-note'; note.textContent = T.approx; box.appendChild(note);
        host.appendChild(box);
        var J = { box: box, svg: svg, done: done, dots: dots, car: car, body: body, cap: cap, list: list, vb: null, hover: 0 };
        car.addEventListener('pointerenter', function () { J.hover = 1; });
        car.addEventListener('pointerleave', function () { J.hover = 0; });
        journeys.push(J);
      };
      var col = document.createElement('div'); col.className = 'journey-col'; reader.appendChild(col);
      makeJourney(col, true);
      var under = document.createElement('div'); under.className = 'journey-under'; head.appendChild(under);
      makeJourney(under, false);

      // 4. where the reader is: between the mentions that move the car (the "anchors")
      var anchorOf = function (p) { return document.querySelectorAll('.prose .place[data-place="' + p.key + '"]')[p.anchor] || null; };
      var state = { leg: 0, f: 0, at: 'bcn', end: false };
      var measure = function () {
        var y = innerHeight * 0.45, tops = travelled.map(function (p) { var a = anchorOf(p); return a ? a.getBoundingClientRect().top : Infinity; });
        var i = -1; tops.forEach(function (t, k) { if (t <= y) i = k; });
        if (i < 0) { state = { leg: 0, f: 0, at: 'bcn', end: false }; return; }
        if (i >= travelled.length - 1) { state = { leg: travelled.length - 1, f: 0, at: travelled[i].key, end: true }; return; }
        var f = Math.max(0, Math.min(1, (y - tops[i]) / (tops[i + 1] - tops[i])));
        state = { leg: i, f: f, at: f > 0.5 ? travelled[i + 1].key : travelled[i].key, end: false };
      };

      // 5. drawing: the car, the road behind it, the frame of the map, the caption and the list
      var lerp = function (a, b, k) { return a + (b - a) * k; };
      var bounds = function (pts, padK, minW, aspect) {
        var x1 = Infinity, y1 = Infinity, x2 = -Infinity, y2 = -Infinity;
        pts.forEach(function (p) { x1 = Math.min(x1, p[0]); y1 = Math.min(y1, p[1]); x2 = Math.max(x2, p[0]); y2 = Math.max(y2, p[1]); });
        var w = Math.max(minW, (x2 - x1) * (1 + padK)), h = Math.max((y2 - y1) * (1 + padK), w / aspect);
        w = Math.max(w, h * aspect);
        return [(x1 + x2) / 2 - w / 2, (y1 + y2) / 2 - h / 2, w, h];
      };
      var jump = { x: 0, y: 0, next: 0 };
      var frame = function (now) {
        var t = now / 1000;
        var leg = legs[Math.min(state.leg, legs.length - 1)];
        var pos = state.end ? { x: G.stops[state.at][0], y: G.stops[state.at][1], ang: 0, j: 0 } : along(leg, state.f);
        // the road travelled so far
        var trail = [];
        for (var i = 0; i < state.leg && i < legs.length; i++) trail = trail.concat(legs[i].pts);
        if (!state.end) trail = trail.concat(leg.pts.slice(0, pos.j), [[pos.x, pos.y]]);
        // the GPS hiccups now and then: a small jump that settles back
        if (!still && t > jump.next) { jump.x = (Math.random() - 0.5) * 2; jump.y = (Math.random() - 0.5) * 2; jump.next = t + 0.5 + Math.random() * 1.2; }
        jump.x *= 0.92; jump.y *= 0.92;
        journeys.forEach(function (J) {
          var r = J.svg.getBoundingClientRect(); if (!r.width) return;
          var aspect = r.width / r.height;
          // the frame: the leg being read (with the car), or the whole road once the chapter's last stop is reached
          var target = state.end ? bounds([].concat.apply([], legs.map(function (l) { return l.pts; })), 0.3, 60, aspect)
            : (function () { var w = Math.max(36, leg.len * 1.15), h = w / aspect; return [pos.x - w / 2, pos.y - h / 2, w, h]; })();   // the car in the middle
          J.vb = J.vb ? J.vb.map(function (v, k) { return still ? target[k] : lerp(v, target[k], 0.06); }) : target;
          J.svg.setAttribute('viewBox', J.vb.map(function (v) { return v.toFixed(2); }).join(' '));
          var k = J.vb[2] / r.width;                     // map units per screen pixel
          J.done.setAttribute('points', trail.join(' '));
          J.dots.forEach(function (d) {
            d.g.querySelector('circle').setAttribute('r', 3 * k);
            var tx = d.g.querySelector('text'); tx.setAttribute('font-size', 11 * k); tx.setAttribute('x', d.xy[0] + 6 * k); tx.setAttribute('y', d.xy[1] + 15 * k);   // below the dot: the car rides above it
            d.g.classList.toggle('is-here', d.g.dataset.place === state.at);
            // names only where they help: the two ends of the leg being read (at the end, the last stop and the one ahead)
            var key = d.g.dataset.place, from = keys[Math.min(state.leg, legs.length - 1)], to = keys[Math.min(state.leg, legs.length - 1) + 1];
            d.g.classList.toggle('named', state.end ? (key === state.at || key === 'alt') : (key === from || key === to));
          });
          // the dance: a sway and a bounce, wilder under the pointer
          var amp = still ? 0 : 1 + J.hover * 2.5;
          var sway = Math.sin(t * 7) * 4 * amp, hop = Math.abs(Math.sin(t * 5)) * -1.2 * amp;
          var face = Math.cos(pos.ang) < 0 ? -1 : 1;
          J.car.setAttribute('transform', 'translate(' + (pos.x + jump.x * k * amp) + ' ' + (pos.y + jump.y * k * amp) + ') scale(' + k * 1.05 + ')');
          J.body.setAttribute('transform', 'translate(0 ' + (hop - 4) + ') rotate(' + sway + ') scale(' + face + ' 1)');
          var p = places.find(function (q) { return q.key === state.at; });
          var text = p.name + ' · ' + p.date;
          if (J.cap.textContent !== text) J.cap.textContent = text;
          if (J.list) J.list.querySelectorAll('li').forEach(function (l) { l.classList.toggle('is-here', l.dataset.place === state.at); });
        });
        requestAnimationFrame(frame);
      };
      var onScroll = function () { measure(); };
      document.addEventListener('scroll', onScroll, { passive: true, capture: true }); addEventListener('resize', onScroll);
      addEventListener('load', onScroll); document.fonts.ready.then(onScroll); measure();
      requestAnimationFrame(frame);

      // 6. hovering a place lights it in the list and on the map; a click or tap opens a small card
      var light = function (k, on) { document.querySelectorAll('.j-list li[data-place="' + k + '"], .j-stop[data-place="' + k + '"]').forEach(function (l) { l.classList.toggle('is-lit', on); }); };
      prose.addEventListener('pointerover', function (e) { var s = e.target.closest('.place'); if (s) light(s.dataset.place, true); });
      prose.addEventListener('pointerout', function (e) { var s = e.target.closest('.place'); if (s) light(s.dataset.place, false); });
      var pop = document.createElement('div'); pop.className = 'pop is-side'; pop.setAttribute('role', 'dialog'); pop.hidden = true; document.body.appendChild(pop);
      var open = function (s) {
        var p = places.find(function (x) { return x.key === s.dataset.place; }), i = travelled.indexOf(p);
        pop.innerHTML = '<button class="pop-x" type="button" aria-label="Close">×</button><div class="pop-body"><p class="pl-name">' + p.name + '</p><p class="pl-where">' + p.where + '</p><p class="pl-stop">' + (p.ahead ? T.end : T.stop + ' ' + (i + 1) + ' of ' + travelled.length) + ' · ' + p.date + '</p></div>';
        var r = s.getBoundingClientRect(), phone = innerWidth <= 700;
        // phones: a sheet from the bottom, as the essays' cards do; wider screens: beside the word
        pop.className = 'pop ' + (phone ? 'is-sheet' : 'is-side');
        pop.hidden = false;
        if (phone) { pop.style.left = ''; pop.style.top = ''; }
        else {
          pop.style.left = Math.max(16, Math.min(r.left + scrollX, scrollX + document.documentElement.clientWidth - pop.offsetWidth - 16)) + 'px';
          pop.style.top = (r.bottom + scrollY + 10) + 'px';
        }
        pop.querySelector('.pop-x').onclick = function () { pop.hidden = true; s.focus(); };
      };
      prose.addEventListener('click', function (e) { var s = e.target.closest('.place.first'); if (s) { e.preventDefault(); e.stopPropagation(); open(s); } });
      prose.addEventListener('keydown', function (e) { var s = e.target.closest && e.target.closest('.place.first'); if (s && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); open(s); } });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') pop.hidden = true; });
      document.addEventListener('pointerdown', function (e) { if (!pop.hidden && !pop.contains(e.target) && !e.target.closest('.place')) pop.hidden = true; });
    });
  </script>
  <style is:global>
    .place.first { cursor: pointer; text-decoration: underline; text-decoration-color: var(--blue-deep); text-decoration-thickness: 1px; text-underline-offset: 0.24em; transition: background var(--dur-2) var(--ease-default); }
    .place.first:hover { background: linear-gradient(transparent 62%, var(--blue) 62%, var(--blue) 92%, transparent 92%); }
    .place.first:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

    .journey-col { grid-column: margin / end; grid-row: 2; position: relative; }
    .journey-col .journey { position: sticky; top: 6rem; }
    .journey { font-family: var(--font-sans); font-size: var(--step--1); color: var(--grey-600); }
    .j-h { margin: 0 0 var(--space-3); letter-spacing: 0.02em; }
    .j-map { display: block; width: 100%; aspect-ratio: 4 / 3; background: var(--paper); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); overflow: hidden; }
    .j-coast { fill: none; stroke: var(--grey-300); stroke-width: 1; }
    .j-road { fill: none; stroke: var(--grey-300); stroke-width: 1.5; stroke-dasharray: 2 3; }
    .j-road.ahead { stroke: var(--grey-200); }
    .j-done { fill: none; stroke: var(--blue-deep); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }
    .j-stop circle { fill: var(--paper); stroke: var(--grey-500); stroke-width: 1; vector-effect: non-scaling-stroke; }
    .j-stop text { fill: var(--grey-600); font-family: var(--font-sans); opacity: 0; transition: opacity var(--dur-2) var(--ease-default); }
    .j-stop.named text, .j-stop.is-lit text { opacity: 1; }
    .j-stop.ahead circle { stroke-dasharray: 1.5 1.5; }
    .j-stop.is-here circle, .j-stop.is-lit circle { fill: var(--blue-deep); stroke: var(--blue-deep); }
    .j-stop.is-here text, .j-stop.is-lit text { fill: var(--ink); }
    .j-car { cursor: pointer; }
    .j-body { fill: var(--paper); stroke: var(--ink); stroke-width: 1.1; stroke-linejoin: round; }
    .j-win { fill: var(--blue); stroke: none; }
    .j-wheel { fill: var(--ink); }
    .j-cap { margin: var(--space-3) 0 0; color: var(--ink); }
    .j-list { list-style: none; margin: var(--space-4) 0 0; padding: 0 0 0 var(--space-4); border-left: 1px solid var(--rule); }
    .j-list li { position: relative; padding: var(--space-1) 0; line-height: 1.3; display: flex; justify-content: space-between; gap: var(--space-3); transition: color var(--dur-2) var(--ease-default); }
    .j-list li::before { content: ""; position: absolute; left: calc(-1 * var(--space-4) - 3.5px); top: calc(var(--space-1) + 0.4em); width: 6px; height: 6px; border-radius: 50%; background: var(--paper); border: 1px solid var(--grey-400); }
    .j-list li .d { color: var(--grey-500); white-space: nowrap; }
    .j-list li.is-here, .j-list li.is-lit { color: var(--ink); }
    .j-list li.is-here .n { background: linear-gradient(transparent 62%, var(--blue) 62%, var(--blue) 92%, transparent 92%); }
    .j-list li.is-here::before { background: var(--blue-deep); border-color: var(--blue-deep); }
    .j-list li.ahead::before { border-style: dashed; }
    .j-list li.ahead .d { font-style: italic; }
    .j-note { margin: var(--space-3) 0 0; font-size: 0.85em; color: var(--grey-500); }
    .journey-under { display: none; }
    .pl-name { font-family: var(--font-display); font-weight: var(--display-weight); font-size: var(--step-1); color: var(--ink); margin: 0 0 var(--space-1); }
    .pl-where { margin: 0; font-style: italic; }
    .pl-stop { margin: var(--space-3) 0 0; font-family: var(--font-sans); color: var(--grey-600); }
    /* where the margin folds away, the journey sits under the title */
    @container page (max-width: 859px) {
      .journey-col { display: none; }
      .journey-under { display: block; margin-top: var(--space-5); }
      .journey-under .j-map { aspect-ratio: 16 / 10; }
    }
    @media print { .journey-col, .journey-under { display: none; } }
  </style>
</PieceView>
