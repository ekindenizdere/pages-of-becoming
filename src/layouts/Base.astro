---
import '../styles/global.css';
import { url } from '../lib';

interface Props { title?: string; description?: string; current?: 'opinion' | 'articles' | 'about'; lang?: string; noindex?: boolean; langs?: { lang: string; href: string }[] }
const { title, description = 'Essays on philosophy, cognitive science and science by Ekin Deniz Dere.', current, lang = 'en', noindex = false, langs = [] } = Astro.props;
const langName: Record<string, string> = { en: 'English', de: 'Deutsch', tr: 'Türkçe' };
const fullTitle = title ? `${title} · Pages of Becoming` : 'Pages of Becoming';
import { homeText, type Lang } from '../home-text';
const L = (['de', 'tr'].includes(lang) ? lang : 'en') as Lang;
const home = url(L === 'en' ? '' : `${L}/`);
// Translated pages point to the sections of their own home page; English keeps the section pages.
const nav = [
  { key: 'opinion', href: L === 'en' ? url('opinion/') : `${home}#opinion`, label: homeText[L].opinion },
  { key: 'articles', href: L === 'en' ? url('articles/') : `${home}#articles`, label: homeText[L].articles },
  { key: 'about', href: `${home}about/`, label: homeText[L].about },
];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  {langs.map((l) => <link rel="alternate" hreflang={l.lang} href={new URL(l.href, Astro.site)} />)}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="preload" href={url('fonts/newsreader.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href={url('styles/fonts.css')} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="wrap">
    <header class="site-head">
      <a class="brand" href={home}>Pages <em>of</em> Becoming</a>
      <nav class="site-nav" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      {langs.length > 1 && (
        <nav class="lang-switch" aria-label={homeText[L].language}>
          {langs.map((l) => (
            <a href={l.href} hreflang={l.lang} lang={l.lang} title={langName[l.lang]} aria-current={l.lang === lang ? 'true' : undefined}>{l.lang.toUpperCase()}</a>
          ))}
        </nav>
      )}
    </header>
    <main id="main"><slot /></main>
    <footer class="site-foot">
      <span>© {new Date().getFullYear()} Ekin Deniz Dere</span>
      <span>{homeText[L].sub}</span>
    </footer>
  </div>
</body>
</html>
