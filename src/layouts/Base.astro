---
import '../styles/global.css';
import { url } from '../lib';

interface Props { title?: string; description?: string; current?: 'opinion' | 'articles'; lang?: string; noindex?: boolean }
const { title, description = 'Essays on philosophy, cognitive science and science by Ekin Deniz Dere.', current, lang = 'en', noindex = false } = Astro.props;
const fullTitle = title ? `${title} · Pages of Becoming` : 'Pages of Becoming';
const nav = [
  { key: 'opinion', href: url('opinion/'), label: 'Opinion Pieces' },
  { key: 'articles', href: url('articles/'), label: 'Articles' },
] as const;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="preload" href={url('fonts/newsreader.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href={url('styles/fonts.css')} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="wrap">
    <header class="site-head">
      <a class="brand" href={url()}>Pages <em>of</em> Becoming</a>
      <nav class="site-nav" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-foot">
      <span>© {new Date().getFullYear()} Ekin Deniz Dere</span>
      <span>The usual confusion but framed professionally</span>
    </footer>
  </div>
</body>
</html>
