---
// About: the bio page, carrying the left page of the home prototype (portrait, bio, the question, the quotes) unchanged.
// Its scripts and styles live in public/home/; the pieces come from src/content/pieces/.
// The only difference from the prototype: the display font is Instrument Serif (see public/home/glyphs.js).
import '../styles/tokens.css';
import { getCollection } from 'astro:content';
import { pieces, pieceUrl, minutes, url } from '../lib';
import { homeText, type Lang } from '../home-text';
import quotesDb from '../data/quotes.json';
// The commonplace: a random handful of the shorter entries is shown on each visit (picked in the browser).
const quotes = quotesDb.quotes.filter((q) => q.show !== false && q.text.length <= 260);

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = homeText[lang];

const all = await pieces();
const published = all.filter((p) => p.data.status === 'published');
const upcoming = all.filter((p) => p.data.status === 'upcoming');

/** First sentence of a piece, as plain text: the "first line as a footnote" in the contents. */
const firstLine = (text = '') => {
  const plain = text
    .replace(/\[\^[^\]]+\]/g, '')
    .replace(/[*_`>#]/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/\s+/g, ' ')
    .trim();
  return plain.match(/^.+?[.?!…](?=\s|$)/)?.[0] ?? plain.slice(0, 120);
};
// Translated title, first line and link where a translation exists; English otherwise.
const translations = lang === 'en' ? [] : await getCollection('translations', (x) => x.data.lang === lang);
const tr = (p: (typeof all)[number]) => translations.find((x) => x.data.source === p.id);
const toItem = (p: (typeof all)[number]) => {
  const x = tr(p);
  if (p.data.status === 'published') {
    return x
      ? { title: x.data.title, min: minutes(p), first: firstLine(x.body), href: url(`${lang}/pieces/${p.id}/`) }
      : { title: p.data.title, min: minutes(p), first: firstLine(p.body), href: pieceUrl(p) };
  }
  const teaser = x?.data.teaser ?? p.data.teaser;
  return { title: x?.data.title ?? p.data.title, upcoming: true, first: teaser ? firstLine(teaser) : undefined };
};
const data = {
  opinion: all.filter((p) => p.data.kind === 'opinion').map(toItem),
  articles: all.filter((p) => p.data.kind === 'article').map(toItem),
};

const description = t.description;
const langs = (['en', 'de', 'tr'] as const).map((l) => ({ lang: l, href: url(l === 'en' ? 'about/' : `${l}/about/`) }));
const home = url(lang === 'en' ? '' : `${lang}/`);
// Build stamp on the home scripts and styles, so every publish reaches visitors without a stale cache.
const build = Date.now().toString(36);
const h = (path: string) => url(`home/${path}?v=${build}`);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{t.about} · Pages of Becoming</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={`${t.about} · Pages of Becoming`} />
  <meta property="og:description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  {langs.map((l) => <link rel="alternate" hreflang={l.lang} href={new URL(l.href, Astro.site)} />)}
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="stylesheet" href={url('styles/fonts.css')} />
  <link rel="stylesheet" href={h('lab.css')} />
  <link rel="stylesheet" href={h('home.css')} />
  <link rel="stylesheet" href={h('home-c.css')} />
</head>
<body class="home about-page">
<header class="site-top">
  <a class="mark" href={home}>Pages <em>of</em> Becoming</a>
  <nav><a class="opt" href={`${home}#opinion`}>{t.opinion}</a><a class="opt" href={`${home}#articles`}>{t.articles}</a><a class="opt" href={langs.find((l) => l.lang === lang)!.href} aria-current="page">{t.about}</a>
    <span class="lang-switch" role="group" aria-label={t.language}>{langs.map((l) => <a href={l.href} hreflang={l.lang} lang={l.lang} aria-current={l.lang === lang ? 'true' : undefined}>{l.lang.toUpperCase()}</a>)}</span>
  </nav>
</header>

<main class="lab-main">
  <section class="lab-section wrap" data-name={t.about} id="about">
    <div class="spread spread-single">
      <div class="page page-left page-about">
        <div class="inner">
          <div class="small-bio" id="ekin">
            <img class="portrait" src={url('images/ekin-portrait.jpg')} alt={t.portraitAlt}>
            <div>
              <div class="bio-links">
              <nav class="social" aria-label={t.elsewhere}>
              <a href="https://www.linkedin.com/in/ekin-deniz-dere-70929b154" target="_blank" rel="noopener noreferrer" aria-label={t.linkedin}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
              <a href="https://www.forbes.at/autor/ekin-deniz-dere" target="_blank" rel="noopener noreferrer" aria-label={t.forbes}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="0" y="0" width="24" height="24" rx="2.2"/><text x="12" y="19.6" text-anchor="middle" font-family="PP Pangaia, Instrument Serif, serif" font-weight="700" font-size="19.5" fill="var(--paper)">F</text></svg>
              </a>
              </nav>
              </div>
            </div>
          </div>
          <h2 class="left-title">{t.sub}</h2>
          {t.note && <p class="label translation-note">{t.note}</p>}
          <p class="ink" data-ink>{t.bio}</p>
          <p class="ink" data-ink>{t.inkA} <mark class="hl">{t.inkB}</mark></p>
          <div class="planes-stage" data-planes="quiet" data-back="off"></div>
          <div class="quote-controls" data-quote-controls>
            <button type="button" data-refresh aria-label={t.commonplace.other} title={t.commonplace.other}>↻</button>
            <button type="button" data-more aria-label={t.commonplace.more} title={t.commonplace.more}>+</button>
            <p class="quote-note" data-note hidden></p>
          </div>
          
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="lab-bottom">
  <div class="counter"><span class="ticks"></span><span data-counter-name>Pages of Becoming</span><span data-counter>01 / 02</span></div>
  <button class="lab-toggle" type="button" data-motion-toggle aria-pressed="true">{t.motion[0]}</button>
</footer>

<script is:inline define:vars={{ data, quotes, i18n: { min: t.min, becoming: t.becoming, motion: t.motion, quotes: t.quotes, commonplace: t.commonplace } }}>window.POB_PIECES = data; window.POB_I18N = i18n; window.POB_QUOTES = quotes;</script>
<script is:inline src={h('vendor/opentype.min.js')}></script>
<script is:inline src={h('vendor/gsap.min.js')}></script>
<script is:inline src={h('vendor/ScrollTrigger.min.js')}></script>
<script is:inline src={h('vendor/SplitText.min.js')}></script>
<script is:inline src={h('vendor/lenis.min.js')}></script>
<script is:inline src={h('lab.js')}></script>
<script is:inline src={h('glyphs.js')}></script>
<script is:inline src={h('motif.js')}></script>
<script is:inline src={h('home.js')}></script>
<script is:inline src={h('home-boot.js')}></script>
</body>
</html>
