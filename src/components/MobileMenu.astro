---
// Phone navigation (≤ 700px), shared by both headers: a quiet "Menu" word beside the languages opens a panel
// under the header with the sections in the display serif, separated by hairlines. Desktop never sees it.
// The links sit in a div with role="navigation" so the header's own `nav a` styles never reach them.
// `edge` pads the panel to the page margin (Eli's full-width fixed header); otherwise it aligns with the brand.
interface Props { links: { href: string; label: string; current?: boolean }[]; menu: string; close: string; edge?: boolean }
const { links, menu, close, edge = false } = Astro.props;
---
<button class="mm-btn" type="button" aria-expanded="false" aria-controls="mm-panel" data-menu={menu} data-close={close}>{menu}</button>
<div class:list={['mm-panel', { edge }]} id="mm-panel" hidden>
  <div class="mm-nav" role="navigation" aria-label={menu}>
    {links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}><span>{l.label}</span></a>)}
  </div>
</div>

<script is:inline>
  (function () {
    var btn = document.currentScript && document.currentScript.parentElement.querySelector('.mm-btn');
    btn = btn || document.querySelector('.mm-btn');
    var panel = document.getElementById('mm-panel');
    if (!btn || !panel) return;
    var set = function (open) {
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? btn.dataset.close : btn.dataset.menu;
      document.documentElement.classList.toggle('mm-open', open);
    };
    btn.addEventListener('click', function () { set(panel.hidden); });
    panel.addEventListener('click', function (e) { if (e.target.closest('a')) set(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !panel.hidden) { set(false); btn.focus(); } });
    matchMedia('(min-width: 701px)').addEventListener('change', function (m) { if (m.matches) set(false); });
  })();
</script>

<style is:global>
  .mm-btn { display: none; }
  .mm-panel[hidden] { display: none; }
  @media (max-width: 700px) {
    .mm-btn {
      display: inline-block; appearance: none; border: 0; background: none; cursor: pointer;
      font-family: var(--font-sans); font-size: var(--step--1); color: var(--ink); letter-spacing: 0.01em;
      padding: 0 0 2px; margin-left: var(--space-4);
      background-image: linear-gradient(var(--blue-deep), var(--blue-deep)); background-position: left bottom;
      background-size: 0 1px; background-repeat: no-repeat; transition: background-size var(--dur-3) var(--ease-default);
    }
    .mm-btn:hover, .mm-btn[aria-expanded="true"] { background-size: 100% 1px; }
    .mm-btn:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
    .mm-panel {
      position: absolute; top: 100%; left: 0; right: 0; z-index: 70;
      background: var(--paper); border-bottom: 1px solid var(--rule);
      padding-block: var(--space-2) var(--space-5);
      box-shadow: 0 18px 28px -26px rgba(0, 0, 0, 0.25);
    }
    .mm-panel.edge { padding-inline: var(--grid-margin); }
    .mm-panel .mm-nav { display: grid; }
    .mm-panel a {
      font-family: var(--font-display); font-weight: var(--display-weight); font-size: var(--step-2); line-height: 1.1;
      color: var(--ink); text-decoration: none; padding: var(--space-4) 0; border-top: 1px solid var(--rule);
    }
    .mm-panel a:first-child { border-top: 0; }
    .mm-panel a[aria-current="page"] span { background: linear-gradient(transparent 62%, var(--blue) 62%, var(--blue) 92%, transparent 92%); }
  }
  @media (prefers-reduced-motion: reduce) { .mm-btn { transition: none; } }
</style>
